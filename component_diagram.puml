@startuml hostelhub_components

!define DIRECTION top to bottom
skinparam componentStyle rectangle

package "HostelHub System" {

  package "Client Layer" {
    component "Web Frontend" as web {
      description: React/Vue App\nUI for Renters & Owners
    }
    component "Mobile App" as mobile {
      description: Mobile Client\n(Optional)
    }
  }

  package "API Gateway & Server Layer" {
    component "API Gateway" as gateway {
      description: Request Router\nAuthentication\nRateLimiting
    }
    component "Auth Service" as auth {
      description: JWT Token\nPassword Hashing\nSession Management
    }
  }

  package "Application Layer" {
    component "User Controller" as userCtrl {
      description: User registration\nProfile management\nBackground check
    }
    component "Listing Controller" as listingCtrl {
      description: Create/Edit listings\nCategory management\nAvailability
    }
    component "Inquiry Controller" as inquiryCtrl {
      description: Rental inquiries\nAgreement handling\nStatus tracking
    }
    component "Chat Controller" as chatCtrl {
      description: Messaging\nUnread counts\nMessage history
    }
    component "Analytics Controller" as analyticsCtrl {
      description: Owner statistics\nInquiry tracking\nListing analytics
    }
  }

  package "Business Logic Layer" {
    component "User Service" as userSvc {
      description: User validation\nPassword encryption\nLeaseTemplate mgmt
    }
    component "Listing Service" as listingSvc {
      description: Listing validation\nAvailability logic\nImage processing
    }
    component "Inquiry Service" as inquirySvc {
      description: Inquiry workflow\nAgreement handling\nStatus management
    }
    component "Chat Service" as chatSvc {
      description: Message handling\nUnread tracking\nChat persistence
    }
    component "Analytics Service" as analyticsSvc {
      description: Statistics calculation\nData aggregation\nReporting
    }
  }

  package "Data Layer" {
    component "MongoDB Database" as db {
      description: User collection\nListing collection\nInquiry collection\nChat collection\nAnalytics collection\nSavedListing collection
    }
  }

  package "External Services" {
    component "Email Service" as email {
      description: Nodemailer\nInquiry notifications\nAgreement alerts
    }
    component "File Upload Service" as upload {
      description: Image Upload\nDocument Storage\nLease Templates
    }
  }

  package "Middleware Layer" {
    component "Authentication Middleware" as authMW {
      description: JWT verification\nRole checking
    }
    component "Upload Middleware" as uploadMW {
      description: File validation\nSize checking\nType validation
    }
    component "Error Handler" as errorHandler {
      description: Error logging\nError response\nValidation errors
    }
  }

  web --> gateway
  mobile --> gateway

  gateway --> authMW
  gateway --> auth
  authMW --> userCtrl
  authMW --> listingCtrl
  authMW --> inquiryCtrl
  authMW --> chatCtrl
  authMW --> analyticsCtrl

  userCtrl --> userSvc
  listingCtrl --> listingSvc
  inquiryCtrl --> inquirySvc
  chatCtrl --> chatSvc
  analyticsCtrl --> analyticsSvc

  userSvc --> db
  listingSvc --> db
  inquirySvc --> db
  chatSvc --> db
  analyticsSvc --> db

  listingCtrl --> uploadMW
  uploadMW --> upload

  inquirySvc --> email
  userSvc --> email

  gateway --> errorHandler
  userCtrl --> errorHandler
  listingCtrl --> errorHandler
  inquiryCtrl --> errorHandler
  chatCtrl --> errorHandler
  analyticsCtrl --> errorHandler

}

@enduml