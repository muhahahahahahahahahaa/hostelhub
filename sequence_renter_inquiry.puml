@startuml hostelhub_renter_inquiry

actor Renter
participant "Web/Mobile\nClient" as client
participant "API\nServer" as api
participant "Auth\nMiddleware" as auth
participant "Listing\nController" as listingCtrl
participant "Inquiry\nController" as inquiryCtrl
participant "Listing\nService" as listingSvc
participant "Inquiry\nService" as inquirySvc
participant "MongoDB\nDatabase" as db
participant "Email\nService" as email

== Phase 1: Renter Views Listings ==

Renter -> client: Open HostelHub App
client -> api: GET /listings\n(search params, filters)
api -> auth: Verify Token
auth --> api: Token Valid ✓

api -> listingCtrl: getListings()
listingCtrl -> listingSvc: Query listings
listingSvc -> db: Find listings\n(category, location, etc.)
db --> listingSvc: Return listing data
listingSvc --> listingCtrl: Formatted listings
listingCtrl --> api: Return 200 OK
api --> client: List of listings
client --> Renter: Display listings

== Phase 2: Renter Views Listing Details ==

Renter -> client: Click on listing
client -> api: GET /listings/{listingId}
api -> auth: Verify Token
auth --> api: Token Valid ✓

api -> listingCtrl: getListingDetails(listingId)
listingCtrl -> listingSvc: Get listing by ID
listingSvc -> db: Find listing\n(with owner info)
db --> listingSvc: Return listing details\n+ owner details\n+ amenities\n+ images
listingSvc --> listingCtrl: Formatted listing
listingCtrl --> api: Return 200 OK
api --> client: Listing details
client --> Renter: Display listing page\n(title, description, price,\nimages, owner info, rules)

== Phase 3: Renter Sends Inquiry ==

Renter -> client: Fill inquiry form
Renter -> client: Submit inquiry
client -> api: POST /inquiry\n{listingId, message}
api -> auth: Verify Token\n(get renter ID)
auth --> api: Token Valid ✓\nrenterId = abc123

api -> inquiryCtrl: createInquiry()
inquiryCtrl -> inquirySvc: Create inquiry

inquirySvc -> db: Check for existing\ninquiry\n{listing, renter}
db --> inquirySvc: No duplicate ✓

inquirySvc -> db: Insert new inquiry\n{status: "New",\nrenter: abc123,\nlisting: xyz789,\nmessage: "...",\ntimestamp}
db --> inquirySvc: Inquiry saved\nwith _id

inquirySvc -> db: Get owner info\nfrom listing
db --> inquirySvc: Return owner data

inquirySvc -> email: Send notification\nto owner\n"New inquiry received\nfor listing"
email --> inquirySvc: Email sent ✓

inquirySvc --> inquiryCtrl: Inquiry created
inquiryCtrl --> api: Return 201 Created
api --> client: {inquiryId, status: "New"}
client --> Renter: "Inquiry sent successfully!\nWaiting for owner response"

== Phase 4: Renter Views Inquiry Status ==

Renter -> client: Go to My Inquiries
client -> api: GET /inquiries\n(renter's inquiries)
api -> auth: Verify Token
auth --> api: Token Valid ✓

api -> inquiryCtrl: getRenterInquiries()
inquiryCtrl -> inquirySvc: Query inquiries
inquirySvc -> db: Find inquiries\nwhere renter = abc123
db --> inquirySvc: Return inquiries\nwith status, listing details
inquirySvc --> inquiryCtrl: Formatted inquiries
inquiryCtrl --> api: Return 200 OK
api --> client: Inquiries list
client --> Renter: Display inquiries\nwith status and timestamps

note over Renter, email
  Status Flow:
  "New" → "Contacted" → "Confirmed" or "Declined"

  Owner can:
  - Contact renter (Chat)
  - Confirm inquiry (status: "Confirmed")
  - Decline inquiry (status: "Declined")
end note

@enduml